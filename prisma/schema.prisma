generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum TransactionType {
  CREDIT
  PAYMENT
}

model ShopSettings {
  id            String   @id @default(cuid())
  userId        String   @unique // Ensures one settings profile per shop owner
  shopName      String   @default("My Shop")
  paymentMethod String   @default("Pochi la Biashara")
  paymentNumber String?
  smsLanguage   String   @default("Kiswahili")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model Customer {
  id           String        @id @default(cuid())
  userId       String
  name         String
  phone        String
  totalBalance Decimal       @default(0) @db.Decimal(12, 2)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  transactions Transaction[]

  @@unique([userId, phone])
  @@index([userId])
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  amount      Decimal         @db.Decimal(12, 2)
  type        TransactionType
  description String?
  mpesaRef    String?
  date        DateTime        @default(now())
  createdAt   DateTime        @default(now())

  @@index([userId])
  @@index([customerId])
  @@index([date])
}